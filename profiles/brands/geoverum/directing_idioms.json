    "device_rules": [
      {
        "match": "year",
        "device": "era_marker",
        "function": "setup",
        "need": "anchor the moment in time"
      },
      {
        "match": "number",
        "device": "numeral",
        "function": "data_callout",
        "need": "make the number felt at a glance"
      },
      {
        "match": "question",
        "device": "mood_dip",
        "function": "hinge",
        "need": "open the curiosity loop before the answer"
      },
      {
        "match": "hazard",
        "words": [
          "arrest",
          "rebel",
          "smuggl",
          "danger",
          "kill",
          "attack",
          "war",
          "virus",
          "pandemic",
          "lockdown",
          "ditangkap",
          "bahaya",
          "pemberontak",
          "penyelundup",
          "perang",
          "virus",
          "pandemi"
        ],
        "device": "hazard_icons",
        "function": "obstacle",
        "need": "make the threat visible on the place it belongs to"
      },
      {
        "match": "uniqueness",
        "words": [
          "only",
          "first",
          "never",
          "record",
          "nobody",
          "pertama",
          "rekor",
          "satu-satunya"
        ],
        "device": "title_card",
        "function": "hook",
        "need": "make the claim unmistakable"
      },
      {
        "match": "proper_noun",
        "device": "pin_and_label",
        "function": "proof",
        "need": "locate the place the narration names"
      },
      {
        "match": "movement",
        "words": [
          "walk",
          "swim",
          "cross",
          "sail",
          "fly",
          "drove",
          "travel",
          "berjalan",
          "berenang",
          "menyeberang",
          "berlayar",
          "terbang"
        ],
        "device": "route_draw",
        "function": "proof",
        "need": "show the movement along its real path"
      },
      {
        "match": "refusal",
        "words": [
          "no",
          "not",
          "denied",
          "banned",
          "refused",
          "without",
          "tanpa",
          "tidak",
          "dilarang",
          "ditolak"
        ],
        "device": "stamp",
        "function": "hinge",
        "need": "make the rule or refusal land as an action"
      },
      {
        "match": "default",
        "device": "camera_drift",
        "function": "proof",
        "need": "keep the subject alive while the clause lands"
      }
    ]
  },
  "critique_rubric": [
    {
      "criterion_id": "single_reading_order",
      "question": "In each frame, is there exactly one dominant element (route head or the beat's focal device), with labels and captions clearly secondary?",
      "weight": 0.9,
      "fail_signs": [
        "two equally loud callouts",
        "labels brighter than the route",
        "caption colour competing with the focal colour"
      ]
    },
    {
      "criterion_id": "narration_visual_match",
      "question": "Does what is on screen at each timestamp show what the caption at that timestamp is saying (place, number, obstacle)?",
      "weight": 0.9,
      "fail_signs": [
        "place named but not visible",
        "number spoken but not shown",
        "visual from the previous clause still dominant"
      ]
    },
    {
      "criterion_id": "layout_tidiness",
      "question": "Are callouts clear of the caption band, clear of the route head and the next second of route, inside side margins, and not overlapping each other?",
      "weight": 0.8,
      "fail_signs": [
        "overlap in grid cells shared with captions",
        "callout covering the head",
        "text cut at the frame edge"
      ]
    },
    {
      "criterion_id": "scale_legibility",
      "question": "Are route stroke, avatars, icons and numerals large enough to read on a phone (route never a hairline, markers not tiny)?",
      "weight": 0.7,
      "fail_signs": [
        "route thinner than 4 px",
        "icons under 100 px",
        "numerals smaller than captions"
      ]
    },
    {
      "criterion_id": "camera_smoothness",
      "question": "Across consecutive sheet frames, does the camera move in one purposeful direction per beat without wobble, and does the subject stay in the middle 60 % of the frame?",
      "weight": 0.8,
      "fail_signs": [
        "subject drifting to the edge",
        "back-and-forth framing between adjacent frames"
      ]
    },
    {
      "criterion_id": "variety_and_escalation",
      "question": "Do consecutive obstacles or reasons use visibly different treatments, with the strongest moment getting the richest surface?",
      "weight": 0.6,
      "fail_signs": [
        "same fill colour twice in a row",
        "climax visually flatter than setup"
      ]
    },
    {
      "criterion_id": "brand_finish",
      "question": "Are colours, typography and chrome consistent with the brand craft (plain captions, no pills or HUD boxes, saturated focal colour on a calm basemap)?",
      "weight": 0.6,
      "fail_signs": [
        "boxed captions",
        "glow on everything",
        "generic interface chrome"
      ]
    }
  ]
}
