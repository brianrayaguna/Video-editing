{
  "schema_version": "1.0",
  "brand_id": "geoverum",
  "idioms": [
    {
      "idiom_id": "hook_event_early",
      "severity": "error",
      "weight": 0.9,
      "params": {
        "max_first_event_s": 0.8
      },
      "rationale": "The first visual event must land before the viewer decides to scroll; an empty or static opening loses the hook."
    },
    {
      "idiom_id": "story_need_stated",
      "severity": "error",
      "weight": 0.8,
      "params": {
        "placeholder_markers": [
          "todo",
          "tbd",
          "?"
        ]
      },
      "rationale": "A visual answer without a stated story need is decoration; every beat names what the viewer must understand."
    },
    {
      "idiom_id": "event_cadence",
      "severity": "warning",
      "weight": 0.7,
      "params": {
        "min_gap_s": 0.25,
        "max_gap_s": {
          "calm": 3.0,
          "default": 2.0,
          "dense": 1.5
        }
      },
      "rationale": "Dense narration carries one visual event every 0.25-1.5 s; longer gaps read as dead air unless the voice pauses."
    },
    {
      "idiom_id": "sync_lead",
      "severity": "warning",
      "weight": 0.75,
      "params": {
        "tolerance_s": 0.1
      },
      "rationale": "Each device class leads its spoken word by a known window (show before you name); late visuals feel like captions, early ones like spoilers."
    },
    {
      "idiom_id": "head_on_place_name",
      "severity": "warning",
      "weight": 0.7,
      "params": {
        "max_early_s": 0.3,
        "max_late_s": 0.05
      },
      "rationale": "On a journey the drawn route tip arriving with each spoken place name lets the map tell the story without extra labels."
    },
    {
      "idiom_id": "regime_change_lead",
      "severity": "warning",
      "weight": 0.6,
      "params": {
        "lead_s": [
          0.3,
          0.9
        ]
      },
      "rationale": "A camera regime change starts before the place is named so the move arrives with the word instead of chasing it."
    },
    {
      "idiom_id": "max_concurrent_callouts",
      "severity": "warning",
      "weight": 0.6,
      "params": {
        "max_concurrent": 3
      },
      "rationale": "More than three transient callouts compete with the route; one in, one out keeps a single reading order."
    },
    {
      "idiom_id": "caption_band_clear",
      "severity": "error",
      "weight": 0.7,
      "params": {
        "band_y_pct": [
          0.66,
          0.76
        ],
        "frame_px": [
          1080,
          1920
        ]
      },
      "rationale": "The caption rail owns its band; a callout inside it makes both unreadable."
    },
    {
      "idiom_id": "callout_min_size",
      "severity": "warning",
      "weight": 0.5,
      "params": {
        "min_size_px": {
          "avatar": 180,
          "icon_cluster": 80,
          "speech_bubble": 300,
          "numeral": 60,
          "stamp": 200
        }
      },
      "rationale": "On a phone, markers under about 100 px read as noise; minimum sizes are measured on 1080x1920 frames."
    },
    {
      "idiom_id": "default_device_share",
      "severity": "warning",
      "weight": 0.6,
      "params": {
        "default_device": "camera_drift",
        "max_share": 0.35
      },
      "rationale": "A film where most clauses only get a camera drift has no visual argument; each stressed phrase deserves a concrete answer (fill, icon, numeral, route segment)."
    },
    {
      "idiom_id": "obstacles_differ",
      "severity": "warning",
      "weight": 0.6,
      "params": {},
      "rationale": "Consecutive obstacles with the same device and treatment read as repetition; alternating kinds reads as escalation."
    },
    {
      "idiom_id": "signature_image_persists",
      "severity": "warning",
      "weight": 0.5,
      "params": {
        "min_beats": 2
      },
      "rationale": "A signature image that appears once is a shot; one that persists and mutates becomes the film's memory."
    },
    {
      "idiom_id": "ending_present",
      "severity": "warning",
      "weight": 0.5,
      "params": {
        "functions": [
          "outro",
          "recap"
        ]
      },
      "rationale": "The film closes on an outro or recap beat rather than stopping mid-chain."
    },
    {
      "idiom_id": "variation_against_recent",
      "severity": "warning",
      "weight": 0.5,
      "params": {
        "lookback": 3
      },
      "rationale": "Consecutive episodes never share both hook mechanism and ending type, and never reuse a signature image."
    }
  ],
  "device_classes": {
    "marker": {
      "devices": [
        "fill",
        "pin",
        "label",
        "icon_pop",
        "pin_and_label",
        "hazard_icons",
        "avatar_pop"
      ],
      "lead_s": [
        0.0,
        0.5
      ]
    },
    "reading": {
      "devices": [
        "numeral",
        "title_card",
        "measurement_line",
        "era_marker",
        "duration_numeral"
      ],
      "lead_s": [
        0.3,
        1.0
      ]
    },
    "camera": {
      "devices": [
        "dive_zoom",
        "pull_out",
        "whip_pan",
        "globe_recap",
        "route_draw"
      ],
      "lead_s": [
        0.3,
        0.9
      ]
    },
    "verb": {
      "devices": [
        "tint_flash",
        "stamp",
        "tool_action",
        "cage_drop"
      ],
      "lead_s": [
        -0.1,
        0.15
      ]
    },
    "counter": {
      "devices": [
        "count_up"
      ],
      "lead_s": [
        0.6,
        2.5
      ]
    },
    "ambient": {
      "devices": [
        "camera_drift",
        "mood_dip",
        "pulse_rings",
        "broll_cutaway"
      ],
      "lead_s": [
        -0.2,
        0.6
      ]
    }
  },
  "camera_regimes": {
    "globe": {
      "zoom": 1.6,
      "route_width_px": 7
    },
    "wide": {
      "zoom": 3.3,
      "route_width_px": 6
    },
    "regional": {
      "zoom": 5.0,
      "route_width_px": 14
    },
    "close": {
      "zoom": 7.0,
      "route_width_px": 26
    }
  },
  "device_realization": {
    "route_draw": {
      "surface": "scene"
    },
    "camera_drift": {
      "surface": "scene"
    },
    "fill": {
      "surface": "scene"
    },
    "dive_zoom": {
      "surface": "scene"
    },
    "pull_out": {
      "surface": "scene"
    },
    "whip_pan": {
      "surface": "scene"
    },
    "globe_recap": {
      "surface": "scene"
    },
    "icon_pop": {
      "surface": "scene"
    },
    "avatar_pop": {
      "surface": "scene"
    },
    "broll_cutaway": {
      "surface": "scene"
    },
    "tint_flash": {
      "surface": "scene"
    },
    "tool_action": {
      "surface": "scene"
    },
    "pin_and_label": {
      "surface": "overlay",
      "template_id": "map_pin_badge",
      "variables": {
        "badge_style": "teardrop",
        "label": "$sync_word",
        "anchor_x_pct": "$x_pct",
        "anchor_y_pct": "$y_pct"
      },
      "min_duration_s": 0.8,
      "max_duration_s": 2.5
    },
    "pin": {
      "surface": "overlay",
      "template_id": "map_pin_badge",
      "variables": {
        "badge_style": "teardrop",
        "label": "",
        "anchor_x_pct": "$x_pct",
        "anchor_y_pct": "$y_pct"
      },
      "min_duration_s": 0.8,
      "max_duration_s": 2.5
    },
    "label": {
      "surface": "overlay",
      "template_id": "map_pin_badge",
      "variables": {
        "badge_style": "teardrop",
        "label": "$sync_word",
        "anchor_x_pct": "$x_pct",
        "anchor_y_pct": "$y_pct"
      },
      "min_duration_s": 0.8,
      "max_duration_s": 2.5
    },
    "hazard_icons": {
      "surface": "overlay",
      "template_id": "map_pin_badge",
      "variables": {
        "badge_style": "circle",
        "label": "$sync_word",
        "anchor_x_pct": "$x_pct",
        "anchor_y_pct": "$y_pct",
        "size_px": "$size_px"
      },
      "min_duration_s": 0.8,
      "max_duration_s": 2.5
    },
    "numeral": {
      "surface": "overlay",
      "template_id": "amber_fact_card",
      "variables": {
        "number": "$number",
        "text": "$clause"
      },
      "min_duration_s": 1.0,
      "max_duration_s": 2.5
    },
    "duration_numeral": {
      "surface": "overlay",
      "template_id": "amber_fact_card",
      "variables": {
        "number": "$number",
        "text": "$clause"
      },
      "min_duration_s": 1.0,
      "max_duration_s": 2.5
    },
    "era_marker": {
      "surface": "overlay",
      "template_id": "amber_fact_card",
      "variables": {
        "number": "$year",
        "text": "$clause"
      },
      "min_duration_s": 1.0,
      "max_duration_s": 2.5
    },
    "title_card": {
      "surface": "overlay",
      "template_id": "chapter_morph_card",
      "variables": {
        "title": "$clause",
        "accent_word": "$sync_word"
      },
      "min_duration_s": 1.0,
      "max_duration_s": 2.2
    },
    "stamp": {
      "surface": "overlay",
      "template_id": "archival_stamp_impact",
      "variables": {
        "stamp_text": "$sync_word_upper",
        "center_x_pct": "$x_pct",
        "center_y_pct": "$y_pct"
      },
      "min_duration_s": 0.8,
      "max_duration_s": 2.0
    },
    "cage_drop": {
      "surface": "overlay",
      "template_id": "archival_stamp_impact",
      "variables": {
        "stamp_text": "$sync_word_upper",
        "center_x_pct": "$x_pct",
        "center_y_pct": "$y_pct"
      },
      "min_duration_s": 0.8,
      "max_duration_s": 2.0
    },
    "mood_dip": {
      "surface": "overlay",
      "template_id": "vignette_mood_dip",
      "variables": {
        "label": ""
      },
      "min_duration_s": 0.8,
      "max_duration_s": 2.0
    },
    "pulse_rings": {
      "surface": "overlay",
      "template_id": "radar_pulse_rings",
      "variables": {
        "center_x_pct": "$x_pct",
        "center_y_pct": "$y_pct"
      },
      "min_duration_s": 1.0,
      "max_duration_s": 3.0
    },
    "measurement_line": {
      "surface": "overlay",
      "template_id": "dual_unit_distance_bracket",
      "variables": {
        "primary_distance": "$number",
        "center_x_pct": "$x_pct",
        "center_y_pct": "$y_pct"
      },
      "min_duration_s": 1.2,
      "max_duration_s": 3.0
    },
    "count_up": {
      "surface": "overlay",
      "template_id": "tabular_metric",
      "variables": {
        "label": "$number",
        "subtitle": "$clause"
      },
      "min_duration_s": 1.2,
      "max_duration_s": 3.0
    }
  },
  "auto_director": {
    "clause_split": {
      "max_words": 7,
      "pause_s": 0.28,
      "punctuation": [
        ".",
        ",",
        "?",
        "!",
        ";",
        ":"
      ]
    },
    "default_lead_s": 0.2,
    "hook_window_s": 3.0,
    "outro_fraction": 0.1,
    "stopwords": [
