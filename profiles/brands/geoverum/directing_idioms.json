  "critique_rubric": [
    {
      "criterion_id": "narration_visual_match",
      "question": "Does what is on screen at each timestamp perform the emotional truth and show what the narration at that timestamp is saying (place, number, obstacle)?",
      "weight": 1.0,
      "fail_signs": [
        "place named but not visible",
        "number spoken but not shown",
        "spoken figure disagrees with on-screen unit label",
        "visual from the previous clause still dominant"
      ]
    },
    {
      "criterion_id": "variety_and_escalation",
      "question": "Do consecutive obstacles or reasons escalate in emotional and visual intensity, with the strongest moment getting the richest surface?",
      "weight": 0.9,
      "fail_signs": [
        "same fill colour twice in a row",
        "climax visually flatter than setup"
      ]
    },
    {
      "criterion_id": "single_reading_order",
      "question": "In each frame, is there exactly one dominant element (route head or the beat's focal device), with labels and captions clearly secondary?",
      "weight": 0.85,
      "fail_signs": [
        "two equally loud callouts",
        "labels brighter than the route",
        "caption colour competing with the focal colour"
      ]
    },
    {
      "criterion_id": "eye_trace_continuity",
      "question": "Across consecutive cuts and beats, does the viewer's eye focus carry smoothly from one focal point to the next without jarring diagonal jumps unless motivated by a reveal?",
      "weight": 0.75,
      "fail_signs": [
        "focal point teleports across opposite frame corners on rapid cuts",
        "unmotivated horizontal screen-direction reversal"
      ]
    },
    {
      "criterion_id": "camera_smoothness",
      "question": "Across consecutive sheet frames, does the camera move in one purposeful direction per beat without wobble, arrive at each framing without a velocity corner, keep map frames sharp at every speed, and keep the subject in the middle 60 % of the frame?",
      "weight": 0.7,
      "fail_signs": [
        "subject drifting to the edge",
        "back-and-forth framing between adjacent frames",
        "camera starting or stopping abruptly inside a beat",
        "smeared or ghosted map frames during an ordinary move",
        "tiles sharpening mid-move or blurry upscaled tiles on a held frame",
        "register swap losing camera momentum or popping abruptly",
        "tool or pointer missing its target contact point on the action frame"
      ]
    },
    {
      "criterion_id": "layout_tidiness",
      "question": "Are callouts clear of the caption band, clear of the route head and the next second of route, inside side margins, and not overlapping each other?",
      "weight": 0.65,
      "fail_signs": [
        "overlap in grid cells shared with captions",
        "callout covering the head",
        "scale ruler crowded against top edge",
        "text cut at the frame edge"
      ]
    },
    {
      "criterion_id": "scale_legibility",
      "question": "Are route stroke, avatars, icons and numerals large enough to read on a phone (route never a hairline, markers not tiny)?",
      "weight": 0.6,
      "fail_signs": [
        "route thinner than 4 px",
        "icons under 100 px",
        "numerals smaller than captions",
        "small text or captions below 7:1 local contrast over bright terrain",
        "cramped negative tracking on small bold labels"
      ]
    },
    {
      "criterion_id": "brand_finish",
      "question": "Are colours, typography and chrome consistent with the brand craft (plain captions, no pills or HUD boxes, saturated focal colour on a calm basemap)?",
      "weight": 0.55,
      "fail_signs": [
        "boxed captions",
        "low-contrast caption shadow over bright snow or ocean",
        "glow on everything",
        "generic interface chrome",
        "display headline collapsed to Regular 400 weight",
        "flat 700 weight hierarchy across primary and secondary labels"
      ]
    },
    {
      "criterion_id": "territory_reveal",
      "question": "When a territory or border is introduced, does its outline draw on along the real perimeter before the fill or flag appears, with the finished outline matching the static rim? Score 1 when the film introduces no territory.",
      "weight": 0.55,
      "fail_signs": [
        "outline appearing whole in one frame",
        "fill or flag visible before the outline closes",
        "flag rendered sideways, cropped to one edge, or spilling past the coast without intent",
        "small floating rectangular flag sticker used instead of full-territory waving glowing flag fill",
        "rim jumping in width or colour when the trace completes"
      ]
    }
  ]
