    "device_rules": [
      {
        "match": "year",
        "device": "era_marker",
        "function": "setup",
        "need": "anchor the moment in time"
      },
      {
        "match": "number",
        "device": "numeral",
        "function": "data_callout",
        "need": "make the number felt at a glance"
      },
      {
        "match": "question",
        "device": "mood_dip",
        "function": "hinge",
        "need": "open the curiosity loop before the answer"
      },
      {
        "match": "corridor_flow",
