{
  "schema_version": "1.0",
  "brand_id": "geoverum",
  "idioms": [
    {
      "idiom_id": "hook_event_early",
      "severity": "error",
      "weight": 0.9,
      "params": {
        "max_first_event_s": 0.8
      },
      "rationale": "The first visual event must land before the viewer decides to scroll; an empty or static opening loses the hook."
    },
    {
      "idiom_id": "story_need_stated",
      "severity": "error",
      "weight": 0.8,
      "params": {
        "placeholder_markers": [
          "todo",
          "tbd",
          "?"
        ]
      },
      "rationale": "A visual answer without a stated story need is decoration; every beat names what the viewer must understand."
    },
    {
      "idiom_id": "event_cadence",
      "severity": "warning",
      "weight": 0.7,
      "params": {
        "min_gap_s": 0.25,
        "max_gap_s": {
          "calm": 3.0,
          "default": 2.0,
          "dense": 1.5
        }
      },
      "rationale": "Dense narration carries one visual event every 0.25-1.5 s; longer gaps read as dead air unless the voice pauses."
    },
    {
      "idiom_id": "sync_lead",
      "severity": "warning",
      "weight": 0.75,
      "params": {
        "tolerance_s": 0.1
      },
      "rationale": "Each device class leads its spoken word by a known window (show before you name); late visuals feel like captions, early ones like spoilers."
    },
    {
      "idiom_id": "head_on_place_name",
      "severity": "warning",
      "weight": 0.7,
      "params": {
        "max_early_s": 0.3,
        "max_late_s": 0.05
      },
      "rationale": "On a journey the drawn route tip arriving with each spoken place name lets the map tell the story without extra labels."
    },
    {
      "idiom_id": "regime_change_lead",
      "severity": "warning",
      "weight": 0.6,
      "params": {
        "lead_s": [
          0.3,
          0.9
        ]
      },
      "rationale": "A camera regime change starts before the place is named so the move arrives with the word instead of chasing it."
    },
    {
      "idiom_id": "max_concurrent_callouts",
      "severity": "warning",
      "weight": 0.6,
      "params": {
        "max_concurrent": 3
      },
      "rationale": "More than three transient callouts compete with the route; one in, one out keeps a single reading order."
    },
    {
      "idiom_id": "caption_band_clear",
      "severity": "error",
      "weight": 0.7,
      "params": {
        "band_y_pct": [
          0.66,
          0.84
        ],
        "frame_px": [
          1080,
          1920
        ]
      },
      "rationale": "The caption rail owns its band; a callout inside it makes both unreadable."
    },
    {
      "idiom_id": "callout_min_size",
      "severity": "warning",
      "weight": 0.5,
      "params": {
        "min_size_px": {
          "avatar": 180,
          "icon_cluster": 80,
          "speech_bubble": 300,
          "numeral": 60,
          "stamp": 200
        }
      },
      "rationale": "On a phone, markers under about 100 px read as noise; minimum sizes are measured on 1080x1920 frames."
    },
    {
      "idiom_id": "default_device_share",
      "severity": "warning",
      "weight": 0.6,
      "params": {
        "default_device": "camera_drift",
        "max_share": 0.35
      },
      "rationale": "A film where most clauses only get a camera drift has no visual argument; each stressed phrase deserves a concrete answer (fill, icon, numeral, route segment)."
    },
    {
      "idiom_id": "obstacles_differ",
      "severity": "warning",
      "weight": 0.6,
      "params": {},
      "rationale": "Consecutive obstacles with the same device and treatment read as repetition; alternating kinds reads as escalation."
    },
    {
      "idiom_id": "signature_image_persists",
      "severity": "warning",
      "weight": 0.5,
      "params": {
        "min_beats": 2
      },
      "rationale": "A signature image that appears once is a shot; one that persists and mutates becomes the film's memory."
    },
    {
      "idiom_id": "ending_present",
      "severity": "warning",
      "weight": 0.5,
      "params": {
        "functions": [
          "outro",
          "recap"
        ]
      },
      "rationale": "The film closes on an outro or recap beat rather than stopping mid-chain."
    },
    {
      "idiom_id": "variation_against_recent",
      "severity": "warning",
      "weight": 0.5,
      "params": {
        "lookback": 3
      },
      "rationale": "Consecutive episodes never share both hook mechanism and ending type, and never reuse a signature image."
    },
    {
      "idiom_id": "numeric_parity",
      "severity": "error",
      "weight": 1.0,
      "params": {
        "ignore_years": true,
        "rel_tolerance": 0.02
      },
      "rationale": "Spoken numeric measurements must match on-screen callout numerals, allowing paired dual-unit displays."
    },
    {
      "idiom_id": "callout_safe_margins",
      "severity": "error",
      "weight": 0.9,
      "params": {
        "frame_px": [
          1080,
          1920
        ],
        "min_x_pct": 0.08,
        "max_x_pct": 0.92,
        "min_y_pct": 0.12,
        "max_y_pct": 0.88,
        "scale_ruler_min_top_pct": 0.12
      },
      "rationale": "Callouts and measurement rulers remain inside broadcast safe margins and avoid clipping near top or side frame edges."
    },
    {
      "idiom_id": "curiosity_loops_closed",
      "severity": "error",
      "weight": 0.85,
      "params": {
        "min_deferred_span_s": 15.0
      },
      "rationale": "Every opened curiosity loop in story.curiosity_loops must pay off after its opening beat, with at least one loop sustaining tension past the hook."
    },
    {
      "idiom_id": "tension_arc_dynamic",
      "severity": "warning",
      "weight": 0.7,
      "params": {
        "min_range": 0.25
      },
      "rationale": "Beat tension levels must span an expressive dynamic range rather than remaining flat."
    },
    {
      "idiom_id": "shot_direction_continuity",
      "severity": "warning",
      "weight": 0.55,
      "params": {},
      "rationale": "Consecutive shots with directional motion should avoid unmotivated horizontal direction reversals across a cut."
    },
    {
      "idiom_id": "split_edit_bounds",
      "severity": "error",
      "weight": 0.6,
      "params": {
        "max_offset_s": 2.5
      },
      "rationale": "J-cut and L-cut split edits must stay within safe timing handles and never pre-lap before timeline zero."
    },
    {
      "idiom_id": "narrative_framework_structure",
      "severity": "warning",
      "weight": 0.55,
      "params": {},
      "rationale": "Explicit narrative frameworks (three_act, story_circle, frame_narrative) should preserve structural proportions and ordered beat progression."
    },
    {
      "idiom_id": "subtext_and_arc_coherence",
      "severity": "warning",
      "weight": 0.5,
      "params": {},
      "rationale": "Character arcs must register a genuine state shift and subtext notes must convey implied meaning beyond literal line restatement."
    },
    {
      "idiom_id": "blocking_axis_continuity",
      "severity": "warning",
      "weight": 0.5,
      "params": {},
      "rationale": "Spatial blocking maintains consistent screen-axis side across cuts without abrupt unmotivated 180-degree flips."
    }
  ],
