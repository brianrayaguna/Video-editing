{
  "schema_version": "1.0",
  "brand_id": "geoverum",
  "schema_note": "Advisory directing playbook only. Not consumed by planner, verifier, compile, master, or audit. Runtime BrandStylePolicy uses soft_priors, hard_guardrails, calibration, and provenance.",
  "grammar_triggers": [
    {
      "trigger_id": "hook_opening_map_dive",
      "condition": "timeline.section == 'hook' and timeline.t_s <= 2.5",
      "action": "camera.dive_globe_and_draw_crimson_silhouette()",
      "weight": 0.94,
      "rationale": "Establish geographic scale from dark bathymetric ocean before drawing the crimson territory silhouette."
    },
    {
      "trigger_id": "single_signal_callout",
      "condition": "speech.contains_geography_or_metric and speech.duration_s >= 1.4",
      "action": "overlay.spawn(kind='kinetic_callout', band='dynamic_away_from_subject')",
      "weight": 0.9,
      "rationale": "Place one primary cartographic signal per beat with generous open-water margins and no redundant badges."
    },
    {
      "trigger_id": "optical_transition_anchor",
      "condition": "transition.kind in {'whip_zoom_blur', 'amber_light_leak'}",
      "action": "audio.sync_sfx_peak_to_transition_midpoint()",
      "weight": 0.91,
      "rationale": "Lock pre-rendered optical whip and solar amber light-leak midpoints to Epidemic SFX waveform peaks."
    },
    {
      "trigger_id": "clause_pause_cut_anchor",
      "condition": "audio.silence_gap_s >= 0.25",
      "action": "timeline.prefer_cut_boundary()",
      "weight": 0.92,
      "rationale": "Align visual transitions cleanly inside natural inter-word speech gaps without slicing words."
    },
    {
      "trigger_id": "relief_climax_crossfade",
      "condition": "timeline.section == 'climax'",
      "action": "video.reveal_sentinel2_aerial_relief()",
      "weight": 0.86,
      "rationale": "Shift from vector cartography into Copernicus Sentinel-2 true-color z11 relief imagery during geological climax."
    },
    {
      "trigger_id": "staggered_dual_territory_compare",
      "condition": "speech.compares_two_territories and overlay.active_fill_count == 0",
      "action": "overlay.stagger_fills(order='mention_order', gap_s=0.65, palette=['secondary_accent','cobalt_azure'])",
      "weight": 0.88,
      "rationale": "When narration compares two territories, stagger fills by mention order; never light two neon accents on the same frame."
    },
    {
      "trigger_id": "influence_flag_pin",
      "condition": "speech.mentions_foreign_presence_in_third_country",
      "action": "overlay.spawn(kind='circular_flag_pin', band='coordinate_anchor')",
      "weight": 0.84,
      "rationale": "Mark foreign presence with a single-family circular flag pin at geographic coordinates; exclude thematic raster icons."
    },
    {
      "trigger_id": "heat_pulse_after_fill_hold",
      "condition": "overlay.fill_hold_s >= 1.2 and speech.contains_tension_or_hazard",
      "action": "overlay.spawn(kind='amber_pulse_nodes', stagger_ms='nonuniform')",
      "weight": 0.82,
      "rationale": "After a territory fill holds long enough to read, fire amber pulse nodes at named hazard points."
    },
    {
      "trigger_id": "map_to_live_broll_handoff",
      "condition": "timeline.section in {'body','escalation','climax'} and shot.kind == 'cartographic' and next_shot.kind == 'live_aerial_or_broll'",
      "action": "transition.prefer(kind in {'clean_crossfade','amber_light_leak'})",
      "weight": 0.87,
      "rationale": "Hand cartographic context into live landscape or wildlife B-roll with a clean dissolve or amber light-leak; never a violet flash."
    },
    {
      "trigger_id": "numbered_fact_card_longform",
      "condition": "platform.aspect == '16:9' and speech.starts_numbered_chapter",
      "action": "overlay.spawn(kind='amber_fact_card', band='lower_third_safe')",
      "weight": 0.8,
      "rationale": "Long-form chapter beats use amber #F5C542 plates with #03161F ink rather than shouty multi-color chrome."
    },
    {
      "trigger_id": "dual_territory_distance_metric",
      "condition": "speech.states_distance_between_two_places and overlay.active_fill_count >= 1",
      "action": "overlay.spawn(kind='distance_metric', band='open_water', tabular=True)",
      "weight": 0.9,
      "rationale": "Place a tabular \u00b1KM bracket in open water between two territories after fills are readable; never cover landmass interiors."
    },
    {
      "trigger_id": "maritime_corridor_draw_on",
      "condition": "speech.mentions_trade_route_or_strategic_strait and overlay.active_corridor_count == 0",
      "action": "overlay.spawn(kind='amber_stroke_dash_corridor', band='route_path')",
      "weight": 0.88,
      "rationale": "Draw one amber maritime corridor as the sole flow signal; forbid red neon bloom and competing spears."
    },
    {
      "trigger_id": "asymmetric_dual_fill_compare",
      "condition": "speech.contrasts_sovereignty_or_neighbor and overlay.active_fill_count == 0",
      "action": "overlay.stagger_fills(order='mention_order', modes=['multiply_tint','terrain_preserve'], gap_s=0.65)",
      "weight": 0.87,
      "rationale": "Compare two sides with staggered treatments: one terrain-preserving tint and one quieter terrain hold\u2014never simultaneous neon paints."
    },
    {
      "trigger_id": "geometric_vs_natural_border_diagram",
      "condition": "speech.explains_border_anomaly_or_river_deviation",
      "action": "overlay.spawn(kind='border_diagram', strokes=['amber_geodesic','hydro_meander'])",
      "weight": 0.86,
      "rationale": "Explain meridian-vs-river bites with two stroke families only; keep labels in quiet margins."
    },
    {
      "trigger_id": "map_to_archival_or_live_broll_handoff",
      "condition": "timeline.section in {'body','escalation','climax'} and shot.kind == 'cartographic' and next_shot.kind in {'archival','live_aerial_or_broll'}",
      "action": "transition.prefer(kind in {'hard_cut','clean_crossfade','amber_light_leak'})",
      "weight": 0.85,
      "rationale": "Hand cartographic context into archival or contemporary B-roll without double-exposure chrome."
    },
    {
      "trigger_id": "continent_to_country_zoom_chain",
      "condition": "timeline.section in {'hook','setup'} and overlay.active_fill_count == 0",
      "action": "camera.zoom_chain(steps=['basin_or_continent','country_fill','optional_detail'])",
      "weight": 0.89,
      "rationale": "Orient the viewer with a wide recognizable shape before the country fill and any detail push; never open on an unlocated close-up."
    },
    {
      "trigger_id": "hydro_lake_outline_stack",
      "condition": "speech.names_rift_or_highland_lakes and overlay.active_hydro_count == 0",
      "action": "overlay.spawn(kind='hydro_lake_outlines', accent='hydro_accent', band='open_water')",
      "weight": 0.83,
      "rationale": "Draw one hydro cyan lake group per beat with curved labels only when shoreline clearance allows."
    },
    {
      "trigger_id": "tectonic_triple_junction_vectors",
      "condition": "speech.mentions_rift_junction_or_plate_divergence and overlay.active_fill_count >= 1",
      "action": "overlay.spawn(kind='plate_vectors', stagger_after_fill_s=0.65)",
      "weight": 0.84,
      "rationale": "After a single territory fill holds, add staggered plate vectors for tectonic divergence zones; never add a second neon wash on the same still."
    },
    {
      "trigger_id": "tabular_metric_on_broll",
      "condition": "speech.states_elevation_capacity_or_length and shot.kind == 'live_aerial_or_broll'",
      "action": "overlay.spawn(kind='tabular_metric', band='dynamic_away_from_subject')",
      "weight": 0.86,
      "rationale": "Place Archivo Black tabular metrics beside live evidence with clearance from the subject silhouette."
    }
  ],
