{
  "schema_version": "1.0",
  "brand_id": "geoverum",
  "schema_note": "Advisory directing playbook only. Not consumed by planner, verifier, compile, master, or audit. Runtime BrandStylePolicy uses soft_priors, hard_guardrails, calibration, and provenance.",
  "grammar_triggers": [
    {
      "trigger_id": "blueprint_tabletop_hook",
      "condition": "timeline.section == 'hook' and timeline.t_s <= 10.0",
      "action": "camera.open_blueprint_tabletop_and_dive_into_region()",
      "weight": 0.94,
      "rationale": "Open on a straight 0-degree full-frame deep blueprint drafting grid (#14427A) with boxless editorial typography, continent silhouette cutout + T-bracket span, or clean media plate, then dive into the focal region."
    },
    {
      "trigger_id": "kinetic_sfx_on_label_reveal",
      "condition": "overlay.spawns_label_metric_or_fill",
      "action": "audio.sync_short_sfx(kinds=['pop','ding','click'], offset_ms=0)",
      "weight": 0.96,
      "rationale": "Lock short acoustic accents directly to territory fills, text labels, metric counters, and transition cuts at 15-28 hits per minute."
    },
    {
      "trigger_id": "whip_zoom_iris_or_card_flip_transition",
      "condition": "transition.kind in {'whip_zoom_blur', 'wipe', 'soft_iris_wipe', '3d_card_flip'}",
      "action": "audio.sync_whoosh_midpoint(duration_s_range=[0.3, 1.0])",
      "weight": 0.93,
      "rationale": "Use pre-rendered 0.3-1.0s radial whip-zooms, vertical white-bar split wipes, soft dark-iris wipes, and 3D card flips for vertical regional leaps."
    },
    {
      "trigger_id": "continuous_map_glide_internal_beats",
      "condition": "shot.duration_s >= 12.0 and shot.kind == 'cartographic'",
      "action": "camera.maintain_continuous_motion(active_ratio>=0.94) and overlay.cycle_state_every_s(3.0, 6.0)",
      "weight": 0.94,
      "rationale": "Sustained continuous map takes (15-60s) maintain active camera motion across >= 94% of half-second windows while cycling graphic overlays every 3-6 seconds."
    },
    {
      "trigger_id": "diagonal_multi_panel_and_analogy_split",
      "condition": "speech.disambiguates_nested_entities_or_draws_country_analogy and platform.aspect == '9:16'",
      "action": "layout.spawn(kind='diagonal_2_or_3_panel_split_or_horizontal_analogy', border='white_4px')",
      "weight": 0.9,
      "rationale": "Diagonal white-bordered 2- or 3-panel splits and horizontal top/bottom analogies disambiguate nested political entities and federal structures immediately."
    },
    {
      "trigger_id": "split_wipe_basemap_compare",
      "condition": "speech.contrasts_apparent_vs_actual_geography and platform.aspect == '9:16'",
      "action": "transition.vertical_white_split_wipe(left='satellite', right='dark_vector_or_blueprint')",
      "weight": 0.91,
      "rationale": "Sweep a vertical white divider bar between satellite relief and dark monochrome vector or blueprint measurement cards to isolate border anomalies and metrics."
    },
    {
      "trigger_id": "multi_territory_rimmed_compare",
      "condition": "speech.compares_two_or_more_territories",
      "action": "overlay.stagger_fills(order='mention_order', gap_s=0.5, border='white_2_3px', texture='terrain_multiply_or_hatch')",
      "weight": 0.92,
      "rationale": "Stagger comparative territory fills in narration mention order using 2-3px white exterior coastline rims and terrain-preserving multiply or diagonal-hatch fills."
    },
    {
      "trigger_id": "dual_unit_distance_bracket",
      "condition": "speech.states_distance_or_dimension",
      "action": "overlay.spawn(kind='dual_unit_distance_bracket', style='white_double_arrow_or_dashed_amber', units=['imperial','metric'], angle='aligned_to_route')",
      "weight": 0.94,
      "rationale": "Pair white double-headed arrows or dashed amber lines with stacked imperial and metric values aligned to the geographic axis."
    },
    {
      "trigger_id": "true_scale_silhouette_or_anchor_overlay",
      "condition": "speech.compares_geographic_size_to_familiar_reference",
      "action": "overlay.drag_silhouette_onto_reference_region_or_place_real_scale_anchor()",
      "weight": 0.89,
      "rationale": "Overlay a true-scale territory silhouette onto a familiar continent or place a scaled real-world aerial anchor beside a micro-feature."
    },
    {
      "trigger_id": "animated_2d_mechanism_cross_section",
      "condition": "speech.explains_physical_geological_underwater_or_ecological_cause",
      "action": "scene.cut_via_whip_zoom_to(kind='2d_vector_cross_section', duration_s_range=[6.0, 19.0], optional_vertical_split_compare=True)",
      "weight": 0.92,
      "rationale": "Cut via radial whip-zoom from overhead maps into flat-vector 2D cross-sections (soil layers, elevation ladders, underwater trenches, or vertical split depth comparisons) to clarify physical mechanisms."
    },
    {
      "trigger_id": "historical_parchment_mode_or_ink_cutaway",
      "condition": "speech.steps_back_into_historical_era",
      "action": "basemap.shift_to_parchment_texture(hex='#B9A386', ocean='#5A7D80', optional_ink_sketch_cutaway=True)",
      "weight": 0.9,
      "rationale": "Shift into straight 0-degree sepia parchment canvases, boxless serif era stamps directly over footage, full archival manuscript sheets, or monochrome 2D ink-sketch cutaways to separate historical eras from modern satellite geography."
    },
    {
      "trigger_id": "myth_debunk_red_x_and_3d_model",
      "condition": "speech.debunks_popular_geographic_misconception",
      "action": "overlay.stamp_crimson_circle_x() and scene.transition_to_3d_scientific_globe_model()",
      "weight": 0.87,
      "rationale": "Stamp a high-contrast crimson circular X over the common assumption before revealing a 3D scientific globe or geoid model."
    },
    {
      "trigger_id": "acronym_and_etymology_header_reveal",
      "condition": "speech.explains_acronym_or_country_name_origin",
      "action": "overlay.spawn(kind='yellow_initial_acronym_or_etymology_plate', band='upper_safe')",
      "weight": 0.85,
      "rationale": "Highlight amber initial letters during acronym expansion or display a bold amber etymology header in the upper safe band."
    },
    {
      "trigger_id": "compact_population_pill_and_flag_cluster",
      "condition": "speech.cites_settlement_population_or_multi_party_presence",
      "action": "overlay.spawn(kind='white_vertical_pin_plus_amber_pop_pill_or_circular_flag_tokens')",
      "weight": 0.88,
      "rationale": "Anchor compact dark-and-amber population pills above vertical white coordinate pins or connect circular flag and portrait tokens with thin white leader lines."
    },
    {
      "trigger_id": "rapid_broll_sensory_proof_burst",
      "condition": "speech.emphasizes_extreme_terrain_or_hazard and platform.aspect == '9:16'",
      "action": "timeline.insert_aerial_broll_burst(clip_count=3_to_4, shot_duration_s_range=[0.85, 2.2], entry='whip_zoom_blur')",
      "weight": 0.87,
      "rationale": "Follow a whip-zoom dive with 3-4 concise real aerial landscape clips (0.85-2.2s each) to ground cartographic claims in real terrain."
    },
    {
      "trigger_id": "vertical_elevation_or_longitude_bands",
      "condition": "speech.explains_altitude_thresholds_or_longitude_zones",
      "action": "overlay.spawn(kind='calibrated_scale_bars_or_vertical_columns', accent='hydro_or_amber')",
      "weight": 0.88,
      "rationale": "Use left-anchored altitude or depth ticks and alternating translucent longitude columns with a single active spotlight strip."
    },
    {
      "trigger_id": "flag_masked_territory_or_coordinate_pin",
      "condition": "speech.establishes_national_sovereignty_or_border_split",
      "action": "overlay.apply_flag_mask_or_rectangular_flag_leader(clean_white_leader=True)",
      "weight": 0.86,
      "rationale": "Clip national flags cleanly inside exterior territory coastlines or attach rectangular flag markers with thin white leader lines on high-resolution ortho imagery."
    },
    {
      "trigger_id": "clause_pause_cut_anchor",
      "condition": "audio.silence_gap_s >= 0.18",
      "action": "timeline.prefer_cut_boundary()",
      "weight": 0.91,
      "rationale": "Align transitions cleanly to natural narration clause boundaries under continuous narration-led pacing."
    },
    {
      "trigger_id": "numbered_fact_card_longform",
      "condition": "platform.aspect == '16:9' and speech.starts_numbered_chapter",
      "action": "overlay.spawn(kind='amber_fact_card', band='lower_third_safe')",
      "weight": 0.8,
      "rationale": "Long-form 16:9 chapter beats use compact amber #F5C542 plates with #03161F ink in the lower-third safe band."
    },
    {
      "trigger_id": "tabular_metric_on_broll",
      "condition": "speech.states_elevation_capacity_or_length and shot.kind == 'live_aerial_or_broll'",
      "action": "overlay.spawn(kind='tabular_metric', band='dynamic_away_from_subject')",
      "weight": 0.86,
      "rationale": "Place boxless Archivo Black tabular metrics beside live evidence with clearance from the focal silhouette and zero dashboard card chrome."
    },
    {
      "trigger_id": "exploded_2d_strata_cross_section",
      "condition": "speech.explains_subsurface_aquifer_geology_or_mine_layers",
      "action": "scene.cut_to(kind='full_bleed_exploded_2d_cross_section', curved_white_arrows=True)",
      "weight": 0.91,
      "rationale": "Separate subsurface strata vertically layer-by-layer across a full-bleed dark canvas with curved white hand-drawn leader arrows rather than enclosing a small diagram inside a card."
    },
    {
      "trigger_id": "boxless_vertical_or_elbow_city_pin",
      "condition": "speech.identifies_city_or_latitude_anchor_on_map",
      "action": "overlay.spawn(kind='coordinate_pin_callout', style='white_vertical_or_elbow_pin_boxless')",
      "weight": 0.93,
      "rationale": "Draw a crisp 2px white vertical or angled elbow leader line from a minimal coordinate dot directly to shadowed bold text with zero HUD box."
    },
    {
      "trigger_id": "boxless_dual_unit_numeric_comparison",
      "condition": "speech.contrasts_two_physical_measurements",
      "action": "overlay.spawn(kind='dual_unit_countup_pair', boxless=True, color_coded=True)",
      "weight": 0.89,
      "rationale": "Place color-coded primary and secondary unit measurements side by side directly on the dark visual canvas with live tabular count-up and zero dashboard frame."
    },
    {
      "trigger_id": "giant_kinetic_title_sweep_or_portal",
      "condition": "speech.introduces_competing_geopolitical_terms_or_core_concept",
      "action": "overlay.spawn(kind='kinetic_portal_title', style='oversized_boxless_sweep_or_zoom_through')",
      "weight": 0.88,
      "rationale": "Sweep bold white display titles directly across glowing cobalt, crimson, or emerald rimmed territory highlights or use oversized lettering as a zoom-through scale portal."
    },
    {
      "trigger_id": "tight_highlight_tag_and_etymology_arrow",
      "condition": "speech.cites_single_line_map_fact_or_place_name_origin",
      "action": "overlay.spawn(kind='coordinate_pin_callout', pin_style='highlight_tag_or_etymology_arrow')",
      "weight": 0.9,
      "rationale": "Use tight 0px-radius amber/charcoal/crimson highlight tags for compact single-line map facts and curved hand-drawn white SVG arrows for place-name etymology links."
    },
    {
      "trigger_id": "organic_hand_drawn_focus_lasso",
      "condition": "speech.isolates_island_archipelago_or_subregion_on_map",
      "action": "overlay.spawn(kind='organic_focus_lasso', stroke_tone='amber_or_white')",
      "weight": 0.89,
      "rationale": "Draw an organic hand-drawn overlapping SVG Bezier oval via stroke-dashoffset directly around the focal landmass without enclosing it in a rigid rectangular box."
    },
    {
      "trigger_id": "t_bracket_and_radius_ring_span",
      "condition": "speech.measures_corridor_width_or_acoustic_blast_radius",
      "action": "overlay.spawn(kind='dual_unit_distance_bracket', line_style='t_bracket_or_radius_ring')",
      "weight": 0.9,
      "rationale": "Use crisp T-bracket callipers on technical blueprint or map widths and expanding concentric radius rings for acoustic or geographic reach."
    },
    {
      "trigger_id": "live_physical_gauge_callout",
      "condition": "speech.describes_temperature_drop_or_extreme_sound_level",
      "action": "overlay.spawn(kind='physical_gauge_callout', gauge_mode='thermometer_or_decibel')",
      "weight": 0.87,
      "rationale": "Pair narration of physical extremes with a boxless animated mercury thermometer or staggered SVG acoustic soundwave decibel counter directly over the map or dark footage."
    },
    {
      "trigger_id": "soft_curtain_or_spyglass_transition",
      "condition": "transition.kind in {'curtain_sweep', 'spyglass_iris'}",
      "action": "overlay.spawn(kind='soft_curtain_transition', mode='curtain_sweep_or_spyglass_iris')",
      "weight": 0.86,
      "rationale": "Pivot between chapters with a pure alpha-gradient feathered dark curtain sweep (zero CSS blur) or circular optical spyglass iris while keeping captions crisp."
    }
  ],
