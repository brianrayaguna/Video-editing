      "render_mode": "parameterized_html",
      "description": "Plain true-centered 2-3 word documentary caption (x=50%, y~70% on 9:16, lower-third on 16:9). Hard-cut switch, proportional sizing.",
      "safe_band": "lower_third",
      "variables": [
        { "id": "text", "type": "string", "label": "Caption phrase (2-3 words)" },
        { "id": "fg_color", "type": "color", "token_ref": "palette_roles.ink", "default": "#F4F1EA" },
        { "id": "bg_color", "type": "color", "token_ref": "palette_roles.ground", "default": "#03161F" },
        {
          "id": "caption_style",
          "type": "enum",
          "enum_values": ["plain", "chip"],
          "default": "plain"
        }
      ]
    },
