{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vedit.local/contracts/edit_plan.schema.json",
  "title": "EditPlan",
  "description": "Cross-runtime Edit Decision Plan bridging Python Director, TypeScript HyperFrames compiler, and distributed cloud rendering workers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "project_id",
    "brand_id",
    "platform_target_id",
    "render_strategy",
    "duration_s",
    "fps",
    "width",
    "height",
    "assets",
    "video_tracks",
    "overlay_compositions",
    "audio_tracks"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "job_id": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "project_id": { "type": "string", "minLength": 1 },
    "brand_id": { "type": "string", "minLength": 1 },
    "platform_target_id": { "type": "string", "minLength": 1 },
    "render_strategy": { "type": "string", "enum": ["hybrid", "full_hf"] },
    "duration_s": { "type": "number", "exclusiveMinimum": 0 },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "timebase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num", "den"],
      "properties": {
        "num": { "type": "integer", "minimum": 1 },
        "den": { "type": "integer", "minimum": 1 }
      }
    },
    "width": { "type": "integer", "minimum": 360 },
    "height": { "type": "integer", "minimum": 360 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "sha256", "kind", "path"],
        "properties": {
          "asset_id": { "type": "string" },
          "sha256": { "type": "string", "minLength": 16, "maxLength": 64, "pattern": "^[0-9a-fA-F]{16,64}$" },
          "kind": { "type": "string", "enum": ["video", "audio_speech", "audio_bgm", "audio_sfx", "audio_ambience", "image", "font"] },
          "path": { "type": "string" },
          "duration_s": { "type": "number", "minimum": 0 },
          "has_audio": { "type": "boolean" }
        }
      }
    },
    "video_tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clip_id", "asset_id", "timeline_start_s", "timeline_duration_s", "source_start_s", "role"],
        "properties": {
          "clip_id": { "type": "string" },
          "asset_id": { "type": "string" },
          "timeline_start_s": { "type": "number", "minimum": 0 },
          "timeline_duration_s": { "type": "number", "exclusiveMinimum": 0 },
          "source_start_s": { "type": "number", "minimum": 0 },
          "start_frame": { "type": ["integer", "null"], "minimum": 0 },
          "duration_frames": { "type": ["integer", "null"], "minimum": 1 },
          "source_start_frame": { "type": ["integer", "null"], "minimum": 0 },
          "role": { "type": "string", "enum": ["a_roll", "b_roll", "screen_recording", "cutaway"] },
          "content_type": {
            "type": "string",
            "enum": ["live_action", "map", "landscape", "diagram", "archival"]
          },
          "visual_beat_count": { "type": "integer", "minimum": 0 },
          "reframed_to_target": { "type": "boolean", "default": true },
          "scale": { "type": "number", "minimum": 0.1, "maximum": 4.0 },
          "transition_in": { "type": ["string", "null"] },
          "j_cut_lead_s": { "type": ["number", "null"], "minimum": 0, "maximum": 4.0 },
          "l_cut_trail_s": { "type": ["number", "null"], "minimum": 0, "maximum": 4.0 },
          "shot_scale": { "type": ["string", "null"], "enum": ["ews", "ws", "ms", "mcu", "cu", "ecu", null] },
          "camera_angle": { "type": ["string", "null"], "enum": ["eye_level", "low_angle", "high_angle", "birds_eye", "dutch", null] },
          "motion_direction": { "type": ["string", "null"], "enum": ["static", "left_to_right", "right_to_left", "push_in", "pull_out", "up", "down", null] },
          "focal_length_mm": { "type": ["number", "null"], "minimum": 12, "maximum": 600 },
          "lighting_key": { "type": ["string", "null"], "enum": ["high_key", "normal_key", "low_key", "chiaroscuro", null] },
          "color_correction": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "exposure_ev": { "type": "number", "minimum": -2.0, "maximum": 2.0 },
              "contrast": { "type": "number", "minimum": 0.5, "maximum": 1.8 },
              "saturation": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
              "temperature": { "type": "number", "minimum": -1.0, "maximum": 1.0 },
              "tint": { "type": "number", "minimum": -1.0, "maximum": 1.0 },
              "gamma": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
              "lift": { "type": ["number", "null"], "minimum": -0.5, "maximum": 0.5 },
              "gain": { "type": ["number", "null"], "minimum": -0.5, "maximum": 0.5 }
            }
          },
          "color_grade": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "preset": { "type": ["string", "null"], "enum": ["neutral", "catastrophe_warm", "dread_dim_vignette", "anomaly_desat", "archival_sepia", "cool_investigative", null] },
              "lut_path": { "type": ["string", "null"] },
              "vignette_strength": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
              "intensity": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            }
          },
          "subject_safe_boxes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["top", "bottom", "left", "right"],
              "properties": {
                "top": { "type": "number", "minimum": 0, "maximum": 1 },
                "bottom": { "type": "number", "minimum": 0, "maximum": 1 },
                "left": { "type": "number", "minimum": 0, "maximum": 1 },
                "right": { "type": "number", "minimum": 0, "maximum": 1 },
                "label": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "overlay_compositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["overlay_id", "kind", "timeline_start_s", "timeline_duration_s", "transparent", "props"],
        "properties": {
          "overlay_id": { "type": "string" },
          "kind": { "type": "string", "enum": ["caption_rail", "kinetic_callout", "lower_third", "data_card", "title_scene", "full_scene"] },
          "timeline_start_s": { "type": "number", "minimum": 0 },
          "timeline_duration_s": { "type": "number", "exclusiveMinimum": 0 },
          "start_frame": { "type": ["integer", "null"], "minimum": 0 },
          "duration_frames": { "type": ["integer", "null"], "minimum": 1 },
          "transparent": { "type": "boolean" },
          "safe_band": { "type": "string", "enum": ["lower_third", "upper_safe", "left_rail", "right_rail", "center_safe", "fullscreen"] },
          "blend_mode": { "type": ["string", "null"], "enum": ["normal", "screen", "multiply", "overlay", "lighten", null] },
          "matte_mode": { "type": ["string", "null"], "enum": ["none", "alpha_matte", "luma_matte", "inverted_alpha", null] },
          "parent_overlay_id": { "type": ["string", "null"] },
          "motion_register": { "type": ["string", "null"], "enum": ["documentary", "wry", "comic", null] },
          "anticipation_ms": { "type": ["integer", "null"], "minimum": 0, "maximum": 250 },
          "overlap_stagger_ms": { "type": ["integer", "null"], "minimum": 0, "maximum": 250 },
          "template_id": { "type": "string", "minLength": 1 },
          "variables": { "type": "object" },
          "track_keyframes": {
            "type": "array",
            "description": "Optional object-tracking or world-space camera-locked motion keyframes relative to overlay start (t_s=0).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["t_s", "x_pct", "y_pct"],
              "properties": {
                "t_s": { "type": "number", "minimum": 0 },
                "x_pct": { "type": "number" },
                "y_pct": { "type": "number" },
                "scale": { "type": "number", "exclusiveMinimum": 0 },
                "rotation_deg": { "type": "number" },
                "rotateX_deg": { "type": "number", "minimum": -75, "maximum": 75 },
                "perspective_px": { "type": "number", "exclusiveMinimum": 0 },
                "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                "curve": { "type": ["string", "null"], "enum": ["linear", "arc_up", "arc_down", "ease_out", "ease_in_out", null] },
                "arc_height_px": { "type": ["number", "null"], "minimum": -400, "maximum": 400 }
              }
            }
          },
          "props": { "type": "object" }
        }
      }
    },
    "audio_tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["track_id", "asset_id", "audio_group", "timeline_start_s", "timeline_duration_s", "source_start_s"],
        "properties": {
          "track_id": { "type": "string" },
          "asset_id": { "type": "string" },
          "audio_group": { "type": "string", "enum": ["voiceover", "music", "sfx", "ambience", "room_tone", "program_mix"] },
          "timeline_start_s": { "type": "number", "minimum": 0 },
          "timeline_duration_s": { "type": "number", "exclusiveMinimum": 0 },
          "source_start_s": { "type": "number", "minimum": 0 },
          "start_frame": { "type": ["integer", "null"], "minimum": 0 },
          "duration_frames": { "type": ["integer", "null"], "minimum": 1 },
          "source_start_frame": { "type": ["integer", "null"], "minimum": 0 },
          "gain_db": { "type": "number", "minimum": -60, "maximum": 24 },
          "carve_against_group": { "type": ["string", "null"] },
          "carve_strength": { "type": "number", "minimum": 0, "maximum": 1 },
          "cleaned_speech_stem": { "type": "boolean" },
          "diegetic": { "type": ["boolean", "null"] },
          "layer_role": { "type": ["string", "null"], "enum": ["sub", "body", "detail", "tail", "riser", "drone", "pulse", "stinger", "hit", null] },
          "pan": { "type": ["number", "null"], "minimum": -1.0, "maximum": 1.0 },
          "reverb_preset": { "type": ["string", "null"], "enum": ["dry", "close", "medium", "wide", null] },
          "fade_in_s": { "type": ["number", "null"], "minimum": 0 },
          "fade_out_s": { "type": ["number", "null"], "minimum": 0 },
          "highpass_hz": { "type": ["number", "null"], "minimum": 20, "maximum": 2000 },
          "lowpass_hz": { "type": ["number", "null"], "minimum": 80, "maximum": 20000 },
          "split_edit_role": { "type": ["string", "null"], "enum": ["j_cut", "l_cut", null] },
          "split_edit_offset_s": { "type": ["number", "null"], "minimum": -5.0, "maximum": 5.0 },
          "haas_delay_ms": { "type": ["number", "null"], "minimum": 0, "maximum": 25.0 },
          "reverb_pan": { "type": ["number", "null"], "minimum": -1.0, "maximum": 1.0 }
        }
      }
    },
    "verifier_passed": { "type": "boolean" }
  }
}
