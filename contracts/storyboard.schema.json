{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vedit.local/contracts/storyboard.schema.json",
  "title": "Storyboard",
  "description": "Clause-level directing plan bound to narration timestamps. Produced automatically from a transcript (`directing_source: auto`) or authored and locked by a director (`user` / `mixed`), or annotated from a reference video (`reference`) to calibrate brand idioms; checked against the brand's executable directing idioms before an EditPlan or map scene is built from it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "brand_id",
    "duration_s",
    "directing_source",
    "story",
    "beats"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "brand_id": {
      "type": "string",
      "minLength": 1
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "directing_source": {
      "enum": [
        "auto",
        "user",
        "mixed",
        "reference"
      ]
    },
    "pacing": {
      "enum": [
        "calm",
        "default",
        "dense"
      ],
      "default": "default"
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape"
      ],
      "properties": {
        "shape": {
          "type": "string",
          "minLength": 1,
          "description": "Detected or chosen story shape id from the brand directing method, or a free-form arrow chain."
        },
        "logline": {
          "type": "string"
        },
        "hook_mechanism": {
          "type": "string"
        },
        "ending_type": {
          "type": "string"
        },
        "signature_image": {
          "type": "string"
        },
        "colour_cast": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "narrative_framework": {
          "type": "string",
          "enum": ["short_shape", "three_act", "story_circle", "frame_narrative"]
        },
        "character_arc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "type": "string", "enum": ["positive", "negative", "flat", "none"] },
            "start_state": { "type": "string" },
            "midpoint_shift": { "type": "string" },
            "end_state": { "type": "string" }
          }
        },
        "story_circle_map": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "you": { "type": "string" },
            "need": { "type": "string" },
            "go": { "type": "string" },
            "search": { "type": "string" },
            "find": { "type": "string" },
            "take": { "type": "string" },
            "return": { "type": "string" },
            "change": { "type": "string" }
          }
        },
        "curiosity_loops": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["loop_id", "question", "opened_beat_id"],
            "properties": {
              "loop_id": { "type": "string", "minLength": 1 },
              "question": { "type": "string", "minLength": 3 },
              "withheld_element": { "type": "string" },
              "opened_beat_id": { "type": "string", "minLength": 1 },
              "promise_hinge_beat_id": { "type": "string" },
              "payoff_beat_id": { "type": "string" }
            }
          }
        }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "description": "Director input layered over brand idiom defaults. Empty for fully automatic films.",
      "properties": {
        "idiom_params": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "disabled_idioms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locked_beat_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "emphasis_words": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "banned_devices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "recent_episodes": {
      "type": "array",
      "description": "Story fields of the brand's previous episodes, used by the variation idiom.",
      "items": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string"
          },
          "hook_mechanism": {
            "type": "string"
          },
          "ending_type": {
            "type": "string"
          },
          "signature_image": {
            "type": "string"
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "description": "Journey path for route-driven films; `markers` name path indices referenced by beat heads.",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "markers": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/beat"
      }
    }
  },
  "$defs": {
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beat_id",
        "start_s",
        "end_s",
        "clause",
        "function",
        "story_need",
        "device"
      ],
      "properties": {
        "beat_id": {
          "type": "string",
          "minLength": 1
        },
        "start_s": {
          "type": "number",
          "minimum": 0,
          "description": "Visual event onset."
        },
        "end_s": {
          "type": "number",
          "minimum": 0
        },
        "clause": {
          "type": "string"
        },
        "function": {
          "enum": [
            "hook",
            "setup",
            "proof",
            "obstacle",
            "hinge",
            "climax",
            "data_callout",
            "broll_bridge",
            "recap",
            "outro"
          ]
        },
        "story_need": {
          "type": "string",
          "minLength": 3
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "treatment": {
          "type": "string",
          "description": "Fill, texture, or icon family; consecutive obstacles must differ."
        },
        "sync_word": {
          "type": "string"
        },
        "sync_word_s": {
          "type": "number",
          "minimum": 0,
          "description": "Spoken onset of the sync word."
        },
        "surface": {
          "type": "string"
        },
        "uses_signature_image": {
          "type": "boolean",
          "default": false
        },
        "hold_reason": {
          "type": "string",
          "description": "Justifies a gap longer than the pacing cadence (a pause in the voice)."
        },
        "transition_in": {
          "type": "string"
        },
        "tension_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "register": {
          "type": "string",
          "enum": ["documentary", "investigative", "wry", "comic"]
        },
        "subtext_note": {
          "type": "string"
        },
        "blend_mode": {
          "type": "string",
          "enum": ["normal", "screen", "multiply", "overlay", "lighten"]
        },
        "blocking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subject_zone": { "type": "string", "enum": ["left", "center", "right", "foreground", "background"] },
            "camera_move": { "type": "string", "enum": ["static", "pan", "tilt", "dolly_in", "dolly_out", "truck", "orbit", "whip_pan"] },
            "axis_side": { "type": "string", "enum": ["left", "right", "neutral"] }
          }
        },
        "color_mood": {
          "type": "string",
          "enum": ["neutral", "catastrophe_warm", "dread_dim_vignette", "anomaly_desat", "archival_sepia", "cool_investigative"]
        },
        "sound_cue": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "function": {
              "type": "string",
              "enum": ["hit", "riser", "drone", "pulse", "stinger", "silence_dropout", "ambience"]
            },
            "diegetic": { "type": "boolean" },
            "silence_dropout_ms": { "type": "number", "minimum": 0, "maximum": 800 },
            "pan_x_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "reverb": { "type": "string", "enum": ["dry", "close", "medium", "wide"] }
          }
        },
        "split_edit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "offset_s"],
          "properties": {
            "kind": { "type": "string", "enum": ["j_cut", "l_cut"] },
            "offset_s": { "type": "number", "minimum": 0, "maximum": 4.0 }
          }
        },
        "shot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scale": { "type": "string", "enum": ["ews", "ws", "ms", "mcu", "cu", "ecu"] },
            "angle": { "type": "string", "enum": ["eye_level", "low_angle", "high_angle", "birds_eye", "dutch"] },
            "movement": { "type": "string", "enum": ["static", "pan", "tilt", "dolly_in", "dolly_out", "truck", "orbit", "whip", "handheld"] },
            "lighting": { "type": "string", "enum": ["natural", "high_key", "low_key", "silhouette", "chiaroscuro"] },
            "motion_direction": { "type": "string", "enum": ["static", "left_to_right", "right_to_left", "push_in", "pull_out", "up", "down"] },
            "look_room": { "type": "string", "enum": ["left", "center", "right"] }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "regime": {
              "enum": [
                "globe",
                "wide",
                "regional",
                "close",
                "hold"
              ]
            },
            "target": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            "zoom": {
              "type": "number"
            },
            "bearing": {
              "type": "number"
            },
            "move_start_s": {
              "type": "number",
              "minimum": 0
            },
            "route_width_px": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Measured on-screen route stroke width (reference annotation)."
            }
          }
        },
        "head": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "marker"
          ],
          "properties": {
            "marker": {
              "type": "string"
            },
            "motion": {
              "enum": [
                "draw",
                "hold",
                "pause"
              ],
              "default": "draw"
            },
            "arrive_s": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "callouts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "avatar",
                  "icon_cluster",
                  "speech_bubble",
                  "numeral",
                  "label",
                  "pin",
                  "stamp"
                ]
              },
              "text": {
                "type": "string"
              },
              "anchor": {
                "enum": [
                  "route_head",
                  "place",
                  "leg",
                  "screen"
                ],
                "default": "route_head"
              },
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "minimum": 0
              },
              "size_px": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "xy": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                },
                "description": "Resolved centre on the output canvas (px)."
              }
            }
          }
        }
      }
    }
  }
}
